{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/obfuscated_session_manifest_v0.1.schema.json",
  "title": "CovertEntryWalker stage-1 dataset manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator_version",
    "config_id",
    "global_seed",
    "variants_per_session",
    "source_session_count",
    "record_count",
    "input_name",
    "input_sha256",
    "config_name",
    "config_sha256",
    "source_schema_sha256",
    "record_schema_sha256",
    "output_name",
    "output_sha256",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "obfuscated-session-manifest/v0.1"
    },
    "generator_version": {
      "$ref": "#/$defs/non_empty_string"
    },
    "config_id": {
      "$ref": "#/$defs/id"
    },
    "global_seed": {
      "$ref": "#/$defs/non_empty_string"
    },
    "variants_per_session": {
      "type": "integer",
      "minimum": 1
    },
    "source_session_count": {
      "type": "integer",
      "minimum": 1
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "input_name": {
      "$ref": "#/$defs/non_empty_string"
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "config_name": {
      "$ref": "#/$defs/non_empty_string"
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "record_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "output_name": {
      "$ref": "#/$defs/non_empty_string"
    },
    "output_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_number", "sample_id", "record_sha256"],
      "properties": {
        "line_number": {
          "type": "integer",
          "minimum": 1
        },
        "sample_id": {
          "$ref": "#/$defs/id"
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
